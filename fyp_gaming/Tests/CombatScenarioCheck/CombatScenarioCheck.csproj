<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Standalone engine-level check for the compact contact scenario and the combat command path.
         Compiles the engine sources directly (no UnityEngine, no NuGet package), like Tests/Harness. -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>LuanShi.CombatScenarioCheck</AssemblyName>
    <RootNamespace>LuanShi.CombatScenarioCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Assets/GameEngine/**/*.cs" />
    <None Include="demo-map.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
