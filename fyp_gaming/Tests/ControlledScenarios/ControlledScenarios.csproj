<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Small controlled-scenario runner. It drives the PRODUCTION runner, spectator session,
    recorder and prompt builder with a fake provider so a later real-provider selection can be
    added without touching the engine. No network, no credential, no Unity assembly.
    Commands: run | validate | test | provider-status | replay (see CsProgram.cs).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>LuanShi.ControlledScenarios</AssemblyName>
    <RootNamespace>LuanShi.ControlledScenarios</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Assets/GameEngine/**/*.cs" />
    <!-- The shipped demo map (exported once by the engine harness); every controlled setup is staged on it. -->
    <None Include="../Harness/demo-map.json" Link="demo-map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="CsDefaultManifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
