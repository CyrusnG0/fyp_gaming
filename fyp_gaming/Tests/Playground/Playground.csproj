<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Reusable headless playground: compiles the real engine sources directly, no UnityEngine and
         no NuGet package. Fake provider is the default; see Program.cs for commands. -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>LuanShi.Playground</AssemblyName>
    <RootNamespace>LuanShi.Playground</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Assets/GameEngine/**/*.cs" />
  </ItemGroup>

</Project>
