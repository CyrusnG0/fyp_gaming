<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Transport/telemetry regression tests for the empty-reply investigation. This project is
    intentionally independent of Tests/Harness/Program.cs so it can be run on its own:
      dotnet run (project path) Tests/ResponseDiagnostics/ResponseDiagnostics.csproj -c Release
    It compiles the real engine sources directly (no UnityEngine, no NuGet packages).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>LuanShi.ResponseDiagnostics.Tests</AssemblyName>
    <RootNamespace>LuanShi.Engine.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Assets/GameEngine/**/*.cs" />
  </ItemGroup>

</Project>
